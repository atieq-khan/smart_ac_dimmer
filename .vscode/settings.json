{
    // Auto-format code on save
    "editor.formatOnSave": true,
    // Disable C/C++ squiggles (optional)
    "C_Cpp.errorSquiggles": "enabled",
    // Set C/C++ default formatter
    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools"
    },
    // Use clang-format with Allman brace style
    "C_Cpp.clang_format_style": "{ BasedOnStyle: LLVM, BreakBeforeBraces: Allman, IndentWidth: 4, ColumnLimit: 500,  AllowShortFunctionsOnASingleLine: false, AllowShortIfStatementsOnASingleLine: false, AllowShortLoopsOnASingleLine: false }",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, BreakBeforeBraces: Allman, IndentWidth: 4, ColumnLimit: 500, AllowShortFunctionsOnASingleLine: false, AllowShortIfStatementsOnASingleLine: false, AllowShortLoopsOnASingleLine: false }",
    // Optional: specify clang-format executable if not auto-detected
    // Windows example: "C_Cpp.clang_format_path": "C:/Program Files/LLVM/bin/clang-format.exe"
    // Linux example: "C_Cpp.clang_format_path": "/usr/bin/clang-format"
    // macOS example: "C_Cpp.clang_format_path": "/opt/homebrew/bin/clang-format"
    // Map standard headers and files to C++ (optional)
    "files.associations": {
        "atomic": "cpp",
        "*.tcc": "cpp",
        "chrono": "cpp",
        "cmath": "cpp",
        "complex": "cpp",
        "unordered_map": "cpp",
        "optional": "cpp",
        "string_view": "cpp",
        "random": "cpp",
        "fstream": "cpp",
        "functional": "cpp",
        "future": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "ostream": "cpp",
        "ratio": "cpp",
        "shared_mutex": "cpp",
        "sstream": "cpp",
        "streambuf": "cpp",
        "regex": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "valarray": "cpp",
        "array": "cpp",
        "deque": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "string": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "memory": "cpp",
        "initializer_list": "cpp",
        "bitset": "cpp",
        "cctype": "cpp",
        "clocale": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "iterator": "cpp",
        "map": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "system_error": "cpp",
        "utility": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "new": "cpp",
        "stdexcept": "cpp",
        "cinttypes": "cpp",
        "typeinfo": "cpp"
    },
}